{
  "name": "lite-onenote-clone",
  "version": "1.0.0",
  "private": true,
  "description": "OneNote Lite - a super-light OneNote-style markdown notes app wrapped as an Android APK with Capacitor",
  "scripts": {
    "sync": "npx cap sync android",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "android": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
